# ============================================================
#  Configuration locale — copie ce fichier en .env
#  (le .env ne doit JAMAIS être commité : voir .gitignore)
# ============================================================

# --- Base de données locale de l'app Rust ---
DATABASE_URL=

# --- Dolibarr ---
DOLIBARR_URL=http://localhost:8081
DOLIBARR_API_KEY=

# --- Conteneur Dolibarr (docker-compose) ---
DB_USER=dolibarr
DB_PASSWORD=dolibarr
DB_NAME=dolibarr
DOLI_URL_ROOT=http://localhost:8081/

# --- Import email factures fournisseur (Gmail IMAP) ---
# Mot de passe d'application à générer sur :
#   https://myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FACTURE_FOLDER=Facture